# Dependencies
node_modules/
.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
coverage/

# Next.js
# NOTE: these are anchored with a leading slash so they only match the
# build output directories at the repository root. Unanchored patterns
# (e.g. "build/") match a directory of that name at ANY depth, which
# silently ignored app/services/build and app/draft/services/build and
# caused a 404 on a deployed route.
/.next/
/out/
/build/
/dist/

# Misc
.DS_Store
*.pem
.idea/
.vscode/

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Env files (do not commit secrets)
.env
.env*.local

# Vercel
.vercel/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# OS
Thumbs.db
desktop.ini

# Editor swap / temp
*.swp
*.swo
